{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devcanvas",
  "version": "0.1.0",
  "identifier": "com.devcanvas.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Devcanvas",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Thai"],
        "displayLanguageSelector": true
      }
    }
  }
}
